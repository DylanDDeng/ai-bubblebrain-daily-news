---
import KnowledgeResults from '../../components/KnowledgeResults.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildKnowledgeSearchIndex } from '../../lib/searchIndex';
import '../../styles/knowledge.css';

const index = await buildKnowledgeSearchIndex();
const sectionLabels = new Map(index.items.map((item) => [item.section, item.section_label]));
---

<BaseLayout
	title="知识搜索 · Bubble's Brain"
	description="搜索 Codex 教程、模型评测与知识文章"
>
	<section class="knowledge-shell knowledge-search" data-knowledge-search>
		<header class="knowledge-heading knowledge-search-heading">
			<div>
				<p class="knowledge-kicker">知识搜索</p>
				<h1>搜索知识库</h1>
				<p>按关键词和栏目，快速找到 Codex 教程、评测与知识文章。</p>
			</div>
			<p class="knowledge-index-state">
				<strong>{index.item_count}</strong><span>篇内容</span>
			</p>
		</header>

		<form class="knowledge-search-form" data-knowledge-search-form method="get" role="search">
			<div class="knowledge-query-field">
				<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
				<label class="sr-only" for="knowledge-query">搜索词</label>
				<input
					id="knowledge-query"
					name="q"
					type="search"
					autocomplete="off"
					placeholder="搜索标题、摘要或标签…"
				/>
			</div>
			<div class="knowledge-filter-field">
				<i class="ph ph-books" aria-hidden="true"></i>
				<label class="sr-only" for="knowledge-section">知识栏目</label>
				<select
					id="knowledge-section"
					name="section"
					hidden
					tabindex="-1"
					aria-hidden="true"
				>
					<option value="">全部栏目</option>
					{
						index.sections.map((section) => (
							<option value={section}>{sectionLabels.get(section)}</option>
						))
					}
				</select>
				<details class="knowledge-filter-menu" data-knowledge-filter-menu>
					<summary>
						<span data-knowledge-filter-label>全部栏目</span>
						<i class="ph ph-caret-down" aria-hidden="true"></i>
					</summary>
					<div class="knowledge-filter-options" role="menu" aria-label="选择知识栏目">
						<button type="button" role="menuitemradio" aria-checked="true" data-section-value="">
							<span>全部栏目</span><i class="ph ph-check" aria-hidden="true"></i>
						</button>
						{
							index.sections.map((section) => (
								<button
									type="button"
									role="menuitemradio"
									aria-checked="false"
									data-section-value={section}
								>
									<span>{sectionLabels.get(section)}</span>
									<i class="ph ph-check" aria-hidden="true" />
								</button>
							))
						}
					</div>
				</details>
			</div>
			<button class="knowledge-search-submit" type="submit"
				><span>搜索</span><i class="ph ph-arrow-right" aria-hidden="true"></i></button
			>
		</form>

		<div class="knowledge-search-status" aria-live="polite">
			<span><strong data-search-result-count>{index.item_count}</strong> 条结果</span>
			<noscript>JavaScript 关闭时展示完整知识索引。</noscript>
		</div>

		<KnowledgeResults items={index.items} filterable />
		<div class="knowledge-empty" data-search-empty hidden={index.item_count !== 0}>
			<p>{index.item_count === 0 ? '知识库还没有可检索的内容。' : '没有找到符合条件的内容。'}</p>
			{
				index.item_count > 0 && (
					<button type="button" data-clear-search>
						清除筛选
					</button>
				)
			}
		</div>
	</section>
</BaseLayout>

<script is:inline type="module" src="/js/knowledge-search.js"></script>
