---
import type { VibeCodingConcept } from '../data/vibeCodingTerms';
import type { VibeCodingDetailProfile } from '../data/vibeCodingTermDetails';

interface Props {
	concept: VibeCodingConcept;
	profile: VibeCodingDetailProfile;
}

const { concept, profile } = Astro.props;
const isComponent = concept.id === 'component';
const isState = concept.id === 'state';
const isProps = concept.id === 'props';
const isResponsive = concept.id === 'responsive-design';
const isDom = concept.id === 'dom';
const isHydration = concept.id === 'hydration';
const isEvent = concept.id === 'event';
const isRouting = concept.id === 'routing';
const isSsr = concept.id === 'ssr';
const isStorage = concept.id === 'browser-storage';
const isBackend = concept.id === 'backend';
const isApi = concept.id === 'api';
const isEndpoint = concept.id === 'endpoint';
const isRuntime = concept.id === 'runtime';
const isMiddleware = concept.id === 'middleware';
const isAuth = concept.id === 'authentication';
const isEnvVar = concept.id === 'environment-variable';
const isPrompt = concept.id === 'prompt';
const isAgentTerm = concept.id === 'agent';
const isVibeCoding = concept.id === 'vibe-coding';
const isContextWindow = concept.id === 'context-window';
const isHarness = concept.id === 'harness';
const isMcp = concept.id === 'mcp';
const isSkillTerm = concept.id === 'skill';
const isRag = concept.id === 'rag';
const isDatabase = concept.id === 'database';
const isSchemaTerm = concept.id === 'schema';
const isMigration = concept.id === 'migration';
const isCacheTerm = concept.id === 'cache';
const isVectorDb = concept.id === 'vector-database';
const isDataStorage = concept.id === 'data-storage';
const isGit = concept.id === 'git';
const isDiff = concept.id === 'diff';
const isCommit = concept.id === 'commit';
const isBranch = concept.id === 'branch';
const isWorktree = concept.id === 'worktree';
const isFork = concept.id === 'fork';
const isPullRequest = concept.id === 'pull-request';
const isCheckpoint = concept.id === 'checkpoint';
const isBuild = concept.id === 'build';
const isCiCd = concept.id === 'ci-cd';
const isServerless = concept.id === 'serverless';
const isEdgeRuntime = concept.id === 'edge-runtime';
const isObservability = concept.id === 'observability';
const isEngWorkflow = concept.id === 'engineering-workflow';
const isDeployRuntime = concept.id === 'deployment-runtime';
---

<figure class="concept-visual" data-concept-animation={concept.categoryId}>
	<header class="concept-visual-header">
		<span>动态说明</span>
		<strong>{profile.visualTitle}</strong>
		<small>{concept.name}</small>
	</header>

	{
		isGit ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">裸奔开干</i>
						<i class="concept-state-b">交给 Git 看管</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>让 AI</code>
						<span>大改 30 个文件</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>保险</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 什么都没存</i>
							<i class="concept-state-b concept-rtm-yes">✓ 先存了个节点</i>
						</span>
					</div>
					<strong>同一场豪赌，两种底气</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">改崩了 · 手动抢救</i>
						<i class="concept-state-b">改崩了 · 一键读档</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>恢复</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 凭记忆一点点撤</i>
							<i class="concept-state-b concept-rtm-yes">✓ 回到上午的节点</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>代价</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">一下午没了</i>
							<i class="concept-state-b concept-rtm-yes">✓ 几秒钟</i>
						</span>
					</div>
					<strong>有历史，才敢放手实验</strong>
				</div>
			</div>
		) : isDiff ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">AI 的汇报</i>
						<i class="concept-state-b">Diff 的事实</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>button.css</code>
						<span class="concept-state-flip">
							<i class="concept-state-a">「按钮改好了」</i>
							<i class="concept-state-b concept-rtm-yes">✓ +2 −1 · 预期内</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>login.js</code>
						<span class="concept-state-flip">
							<i class="concept-state-a">（只字未提）</i>
							<i class="concept-state-b concept-rtm-no">✗ 还删了 5 行！</i>
						</span>
					</div>
					<strong>汇报会漏，事实不会</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">照单全收</i>
						<i class="concept-state-b">逐行过目</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>按钮</code>
						<span class="concept-rtm-yes">✓ 变蓝了</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>登录</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 三天后才发现坏了</i>
							<i class="concept-state-b concept-rtm-yes">✓ 当场让它撤销</i>
						</span>
					</div>
					<strong>每行改动，过目再放行</strong>
				</div>
			</div>
		) : isCommit ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">一天一大包</i>
						<i class="concept-state-b">一步一提交</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>提交</code>
						<span class="concept-state-flip">
							<i class="concept-state-a">20 个文件 ·「更新」</i>
							<i class="concept-state-b concept-rtm-yes">✓ 3 个文件 · 说明清楚</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>历史</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 一团毛线</i>
							<i class="concept-state-b concept-rtm-yes">✓ 一步一个脚印</i>
						</span>
					</div>
					<strong>同样的一天，两种历史</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">回退 · 整包端走</i>
						<i class="concept-state-b">回退 · 精准摘除</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>撤支付</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 登录也被连累</i>
							<i class="concept-state-b concept-rtm-yes">✓ 只回退那一笔</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>找原因</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗「更新」毫无线索</i>
							<i class="concept-state-b concept-rtm-yes">✓ 按说明直达</i>
						</span>
					</div>
					<strong>拆得清，才退得回</strong>
				</div>
			</div>
		) : isBranch ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">直接改主线</i>
						<i class="concept-state-b">开分支再改</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>大重构</code>
						<span>AI 改到一半</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>主线</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 跟着半残</i>
							<i class="concept-state-b concept-rtm-yes">✓ 原样可用</i>
						</span>
					</div>
					<strong>实验和主线，要不要隔离</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">急 bug · 被卡死</i>
						<i class="concept-state-b">急 bug · 随时能修</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>发版</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 带着半成品发不了</i>
							<i class="concept-state-b concept-rtm-yes">✓ 主线干净随时发</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>重构</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 只能先撤销</i>
							<i class="concept-state-b concept-rtm-yes">✓ 分支上继续</i>
						</span>
					</div>
					<strong>平行推进，互不绑架</strong>
				</div>
			</div>
		) : isWorktree ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">一个目录来回切</i>
						<i class="concept-state-b">一条分支一个目录</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>你</code>
						<span>重构改到一半</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>Agent</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 等你让出目录</i>
							<i class="concept-state-b concept-rtm-yes">✓ 隔壁目录开工</i>
						</span>
					</div>
					<strong>一个工位，还是各有工位</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">切换 · 处处收拾</i>
						<i class="concept-state-b">并行 · 互不打扰</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>切分支</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 先收好半成品</i>
							<i class="concept-state-b concept-rtm-yes">✓ 换个窗口就是</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>文件</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 被对方改乱</i>
							<i class="concept-state-b concept-rtm-yes">✓ 各改各的</i>
						</span>
					</div>
					<strong>历史共用一份，现场各占一个</strong>
				</div>
			</div>
		) : isFork ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">直接改原仓库</i>
						<i class="concept-state-b">先 Fork 到自己名下</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>发现 bug</code>
						<span>常用的开源库</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>写权限</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 没有 · push 被拒</i>
							<i class="concept-state-b concept-rtm-yes">✓ 副本完全归你</i>
						</span>
					</div>
					<strong>别人的仓库，你的想法</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">等 · 不知到哪天</i>
						<i class="concept-state-b">改 · 现在就动手</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>修复</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 提个 issue 干等</i>
							<i class="concept-state-b concept-rtm-yes">✓ 副本里自己修好</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>回馈</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 无从谈起</i>
							<i class="concept-state-b concept-rtm-yes">✓ PR 提回上游</i>
						</span>
					</div>
					<strong>开源协作，从复制一份开始</strong>
				</div>
			</div>
		) : isPullRequest ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">直接推主线</i>
						<i class="concept-state-b">先发 PR</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>改动</code>
						<span>AI 重构 · 30 个文件</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>把关</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 没人看过</i>
							<i class="concept-state-b concept-rtm-yes">✓ 检查 + 评审</i>
						</span>
					</div>
					<strong>进主线前，有没有人看</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">问题在线上爆</i>
						<i class="concept-state-b">问题被评审拦</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>边界 bug</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 用户先发现</i>
							<i class="concept-state-b concept-rtm-yes">✓ 评审时被指出</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>代价</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 半夜回滚</i>
							<i class="concept-state-b concept-rtm-yes">✓ 改一版再合</i>
						</span>
					</div>
					<strong>拦在门外，代价最小</strong>
				</div>
			</div>
		) : isCheckpoint ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">三小时不打点</i>
						<i class="concept-state-b">一步一个点</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>Agent</code>
						<span>连续大改 3 小时</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>检查点</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 一个没存</i>
							<i class="concept-state-b concept-rtm-yes">✓ 每步一个</i>
						</span>
					</div>
					<strong>同样的冒险，不同的赌注</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">摔回山脚</i>
						<i class="concept-state-b">摔回上个锚点</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>损失</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 3 小时全部</i>
							<i class="concept-state-b concept-rtm-yes">✓ 最近 10 分钟</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>心态</code>
						<span class="concept-state-flip">
							<i class="concept-state-a">不敢再让它动</i>
							<i class="concept-state-b concept-rtm-yes">✓ 回滚重来就是</i>
						</span>
					</div>
					<strong>打点越勤，输得越少</strong>
				</div>
			</div>
		) : isBuild ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<small>源代码 · 给人读的</small>
					<p>
						<code>main.ts</code>
						<span>TypeScript · 300 个文件</span>
					</p>
					<p>
						<code>依赖</code>
						<span>引用几十个库</span>
					</p>
					<strong>浏览器读不了这些</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
					<b />
				</i>
				<div class="concept-instance-page">
					<div class="concept-bk-row" style="--bk-index: 0" aria-hidden="true">
						<i class="ph ph-shield-check" />
						检查 · 类型错误拦在这
						<em class="ph ph-check-circle" />
					</div>
					<div class="concept-bk-row" style="--bk-index: 1" aria-hidden="true">
						<i class="ph ph-gear" />
						转换 · TS 变 JS、语法降级
						<em class="ph ph-check-circle" />
					</div>
					<div class="concept-bk-row" style="--bk-index: 2" aria-hidden="true">
						<i class="ph ph-package" />
						打包 · 压缩后只剩零头
						<em class="ph ph-check-circle" />
					</div>
					<div class="concept-bk-ok" aria-hidden="true">
						dist/ · 可部署的产物
					</div>
					<strong>从给人读，到给机器跑</strong>
				</div>
			</div>
		) : isCiCd ? (
			<div class="concept-instance-visual" aria-label={profile.visualTitle}>
				<div class="concept-instance-source">
					<em class="concept-state-flip concept-rtm-head" aria-hidden="true">
						<i class="concept-state-a">手动发布</i>
						<i class="concept-state-b">流水线发布</i>
					</em>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>工序</code>
						<span class="concept-state-flip">
							<i class="concept-state-a">测试打包上传靠人</i>
							<i class="concept-state-b concept-rtm-yes">✓ 合并后全自动</i>
						</span>
					</div>
					<div class="concept-rtm-row" aria-hidden="true">
						<code>今天</code>
						<span class="concept-state-flip">
							<i class="concept-state-a concept-rtm-no">✗ 忘了跑测试</i>
							<i class="concept-state-b concept-rtm-yes">✓ 一步不落</i>
						</span>
					</div>
					<strong>靠自觉，还是靠流程</strong>
				</div>
				<i class="concept-instance-wire" aria-hidden="true">
