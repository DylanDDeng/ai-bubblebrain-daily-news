---
import { getEntry, render } from 'astro:content';
import { Buffer } from 'node:buffer';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';
import {
	legacyAlternate,
	legacyChildren,
	legacyEntryIsRoutable,
	loadLegacyContent,
	type LegacyContentEntry,
} from '../lib/legacyContent';
import ImageCompressTool from './tools/ImageCompressTool.astro';
import AIInfographicTool from './tools/AIInfographicTool.astro';
import Discussion from './Discussion.astro';
import DirectoryItemRow from './DirectoryItemRow.astro';
import HighlightArchive from './HighlightArchive.astro';
import {
	highlightItemsFor,
	highlightMonthGroups,
	highlightYears,
	type HighlightArchiveItem,
} from '../lib/highlightsArchive';
import ArticleOutline from './ArticleOutline.astro';
import { commentThreadId } from '../lib/comments/threadId';
import '../styles/legacy-pages.css';
import '../styles/ai-infographic.css';

interface Props {
	record: LegacyContentEntry;
	markdownId: string | null;
	markdownCollection: 'legacy' | 'highlights' | null;
}

interface HighlightItem {
	id: string;
	title: string;
	description?: string;
	thumb?: string;
	tags?: string[];
	originalUrl?: string;
	detailUrl?: string;
	date?: string;
}

interface ModelEvalItem {
	id: string;
	name: string;
	company?: string;
	logo?: string;
	releaseDate?: string;
	description?: string;
	tags?: string[];
}

interface PromptItem {
	id: string;
	title: string;
	description?: string;
	model?: string;
	date?: string;
	tags?: string[];
	detailUrl?: string;
}

interface XTrendingItem {
	id: string;
	date?: string;
	title: string;
	description?: string;
	author_name?: string;
	author_handle?: string;
	originalUrl?: string;
	thumb?: string;
	tags?: string[];
}

interface AiToolItem {
	id: string;
	name: string;
	company?: string;
	domain?: string;
	logo?: string;
	url?: string;
}

interface CurationItem {
	id: string;
	date?: string;
	title: string;
	description?: string;
	tags?: string[];
	originalUrl?: string;
	detailUrl?: string;
}

type DirectoryKind =
	| 'highlights'
	| 'prompts'
	| 'model-evals'
	| 'x-trending'
	| 'ai-tools'
	| 'curations'
	| 'codex-tutorials'
	| 'deepseek-harness-tutorials'
	| 'workbuddy-tutorials';

const { record, markdownId, markdownCollection } = Astro.props;
const isEnglish = record.locale === 'en';
const allRecords = await loadLegacyContent();
const alternate = legacyAlternate(record, allRecords);
const children = legacyChildren(record, allRecords);
const markdownEntry =
	markdownId && markdownCollection === 'highlights'
		? await getEntry('highlights', markdownId)
		: markdownId && markdownCollection === 'legacy'
			? await getEntry('legacy', markdownId)
			: null;
const rendered = markdownEntry ? await render(markdownEntry) : null;
const MarkdownContent = rendered?.Content;
const outlineHeadings =
	rendered?.headings.filter((heading) => heading.depth === 2 || heading.depth === 3) ?? [];
const sourceUrl =
	typeof record.frontmatter.sourceUrl === 'string' ? record.frontmatter.sourceUrl : null;
const articleTags = Array.isArray(record.frontmatter.tags)
	? record.frontmatter.tags.filter((tag): tag is string => typeof tag === 'string')
	: [];
const readingMinutesFor = (body: string) => {
	const units =
		(body.match(/[\u3400-\u9fff]/g)?.length ?? 0) +
		(body.replace(/[\u3400-\u9fff]/g, ' ').match(/[A-Za-z0-9]+(?:['\u2019-][A-Za-z0-9]+)*/g)
			?.length ?? 0);
	return Math.max(1, Math.ceil(units / (isEnglish ? 220 : 360)));
};
const readingMinutes = readingMinutesFor(record.body);
const sourceLabel = sourceUrl
	? (() => {
			try {
				return new URL(sourceUrl).hostname.replace(/^www\./, '');
			} catch {
				return isEnglish ? 'Original source' : '原文链接';
			}
		})()
	: null;
const articleFactCount = 2 + Number(Boolean(record.date)) + Number(Boolean(sourceUrl));
const staticRoot = resolve(process.cwd(), '../static');
const pageLabels: Record<string, { zh: string; en: string; kicker: string }> = {
	about: { zh: '关于', en: 'About', kicker: 'ABOUT THE ARCHIVE' },
	'ai-tools': { zh: 'AI 工具', en: 'AI Tools', kicker: 'USEFUL INSTRUMENTS' },
	'codex-tutorials': { zh: 'Codex 教程', en: 'Codex Tutorials', kicker: 'CODEX GUIDE' },
	'deepseek-harness-tutorials': {
		zh: 'DeepSeek Harness 教程',
		en: 'DeepSeek Harness Tutorials',
		kicker: 'DEEPSEEK HARNESS GUIDE',
	},
	'workbuddy-tutorials': {
		zh: 'WorkBuddy 教程',
		en: 'WorkBuddy Tutorials',
		kicker: 'WORKBUDDY GUIDE',
	},
	curations: { zh: '论文精选', en: 'Curations', kicker: 'PAPER DIGESTS' },
	highlights: { zh: '精选阅读', en: 'Highlights', kicker: 'EDITOR’S SELECTION' },
	'model-evals': { zh: '模型评测', en: 'Model Reviews', kicker: 'MODEL LEDGER' },
	'my-publish': { zh: '我的文章', en: 'My Writing', kicker: 'PERSONAL NOTES' },
	prompts: { zh: 'Prompt 收录', en: 'Prompts', kicker: 'PROMPT LIBRARY' },
	'x-trending': { zh: 'X 热门内容', en: 'X Trending', kicker: 'SOCIAL SIGNALS' },
};
const label = pageLabels[record.section];
const title = record.isIndex
	? isEnglish
		? label.en
		: label.zh
	: record.title && !record.title.includes('-')
		? record.title
		: isEnglish
			? label.en
			: label.zh;
const description =
	record.description ||
	(isEnglish ? `Browse the ${label.en.toLowerCase()} archive.` : `浏览${label.zh}的历史内容。`);
const yearMatch = record.route.match(/\/model-evals\/(\d{4})\/$/);
const dataPrefix = isEnglish ? 'en/' : '';
let directoryItems: Array<
	HighlightItem | PromptItem | ModelEvalItem | XTrendingItem | AiToolItem | CurationItem
> = [];
let directoryKind: DirectoryKind | null = null;
if (
	record.isIndex &&
	[
		'highlights',
		'prompts',
		'model-evals',
		'x-trending',
		'ai-tools',
		'curations',
		'codex-tutorials',
		'deepseek-harness-tutorials',
		'workbuddy-tutorials',
	].includes(record.section)
) {
	directoryKind = record.section as DirectoryKind;
	if (record.section === 'highlights') {
		directoryItems = highlightItemsFor(children);
	} else if (
		['prompts', 'codex-tutorials', 'deepseek-harness-tutorials', 'workbuddy-tutorials'].includes(
			record.section,
		)
	) {
		directoryItems = children.map((child) => ({
			id: child.route,
			title: child.title,
			description: child.description,
			model: typeof child.frontmatter.model === 'string' ? child.frontmatter.model : undefined,
			date: child.date?.toISOString().slice(0, 10),
			tags: Array.isArray(child.frontmatter.tags)
				? child.frontmatter.tags.filter((tag): tag is string => typeof tag === 'string')
				: [],
			detailUrl: child.route,
		}));
	} else {
		const filename =
			record.section === 'model-evals' && yearMatch
				? `model-evals-${yearMatch[1]}.json`
				: `${record.section}.json`;
		directoryItems = JSON.parse(await readFile(resolve(staticRoot, dataPrefix, filename), 'utf8'));
	}
}
const tutorialKinds = ['codex-tutorials', 'deepseek-harness-tutorials', 'workbuddy-tutorials'];
const isTutorialIndex = record.isIndex && tutorialKinds.includes(record.section);
const isHighlightsIndex = record.isIndex && record.section === 'highlights';
const chapters = isTutorialIndex
	? [...children]
			.sort((a, b) => {
				const weightA = typeof a.frontmatter.weight === 'number' ? a.frontmatter.weight : 999;
				const weightB = typeof b.frontmatter.weight === 'number' ? b.frontmatter.weight : 999;
				return weightA - weightB || (a.date?.getTime() ?? 0) - (b.date?.getTime() ?? 0);
			})
			.map((child) => ({
				route: child.route,
				title: child.title,
				description: child.description,
				date: child.date?.toISOString().slice(0, 10),
				minutes: readingMinutesFor(child.body),
			}))
	: [];
const highlightAll = isHighlightsIndex ? (directoryItems as HighlightArchiveItem[]) : [];
const highlightYearList = highlightYears(highlightAll);
const latestHighlightYear = highlightYearList[0]?.year ?? '';
const mainHighlightItems = highlightAll.filter(
	(item) => !item.date || item.date.startsWith(latestHighlightYear),
);
const highlightMonths = highlightMonthGroups(mainHighlightItems, record.locale);
const otherSeries = isTutorialIndex
	? tutorialKinds
			.filter((kind) => kind !== record.section)
			.map((kind) => {
				const indexEntry = allRecords.find(
					(entry) => entry.section === kind && entry.locale === record.locale && entry.isIndex,
				);
				const count = allRecords.filter(
					(entry) =>
						entry.section === kind &&
						entry.locale === record.locale &&
						!entry.isIndex &&
						legacyEntryIsRoutable(entry),
				).length;
				return indexEntry && count > 0
					? {
							href: `${isEnglish ? '/en' : ''}/${kind}/`,
							title: isEnglish ? pageLabels[kind].en : pageLabels[kind].zh,
							description: indexEntry.description,
							count,
						}
					: null;
			})
			.filter((series): series is NonNullable<typeof series> => series !== null)
	: [];
const knownRoutes = new Set(allRecords.filter(legacyEntryIsRoutable).map((entry) => entry.route));
const articleSiblings = allRecords
	.filter(
		(entry) =>
			entry.section === record.section &&
			entry.locale === record.locale &&
			!entry.isIndex &&
			legacyEntryIsRoutable(entry),
	)
	.sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
const articleIndex = articleSiblings.findIndex((entry) => entry.route === record.route);
const newer = articleIndex > 0 ? articleSiblings[articleIndex - 1] : null;
const older =
	articleIndex >= 0 && articleIndex < articleSiblings.length - 1
		? articleSiblings[articleIndex + 1]
		: null;
const sectionHref = `${isEnglish ? '/en' : ''}/${record.section}/`;
const isImageCompressor = record.route.endsWith('/ai-tools/image-compress/');
const isAIInfographic = record.route.endsWith('/ai-tools/ai-infographics/');
const isStandaloneHtml = record.sourcePath.endsWith('.html');
const standaloneSrc = isStandaloneHtml
	? `data:text/html;base64,${Buffer.from(record.body, 'utf8').toString('base64')}`
	: null;
const threadId =
	!record.isIndex && !isImageCompressor && !isAIInfographic
		? commentThreadId({
				route: record.route,
				locale: record.locale,
				chineseAlternateRoute: isEnglish ? alternate?.route : null,
			})
		: null;
const libraryApi =
	directoryKind === 'prompts'
		? `https://content-api.bubblenews.today/v1/prompts?locale=${record.locale}&limit=200`
		: directoryKind === 'model-evals'
			? `https://content-api.bubblenews.today/v1/model-evals?locale=${record.locale}${
					yearMatch ? `&year=${yearMatch[1]}` : ''
				}&limit=200`
			: undefined;
---

<BaseLayout
	title={`${title} · Bubble's Brain`}
	description={description}
	lang={record.locale}
	alternateHref={alternate?.route}
	canonicalPath={record.route}
>
	{
		record.isIndex ? (
			<section
				class="legacy-shell directory-page"
				data-directory-page={directoryKind ?? undefined}
				data-library-api={libraryApi}
			>
				<header class="directory-hero">
					<div>
						<p class="page-kicker">{label.kicker}</p>
						<h1>
							{yearMatch
								? `${yearMatch[1]} · ${isEnglish ? label.en : label.zh}`
								: isEnglish
									? label.en
									: label.zh}
						</h1>
						{record.section !== 'about' && <p>{description}</p>}
					</div>
					{isTutorialIndex ? null : isHighlightsIndex ? (
						<p class="directory-count directory-count--series">
							<strong data-directory-count>{directoryItems.length}</strong>
							<span>{isEnglish ? 'picks · updated continually' : '篇 · 持续收录中'}</span>
						</p>
					) : (
						<p class="directory-count">
							<>
								<strong data-directory-count>{directoryItems.length || children.length}</strong>
								<span>{isEnglish ? 'records' : '条记录'}</span>
							</>
						</p>
					)}
				</header>

				{MarkdownContent &&
					![
						'highlights',
						'codex-tutorials',
						'deepseek-harness-tutorials',
						'workbuddy-tutorials',
					].includes(directoryKind ?? '') && (
						<div class="directory-intro">
							<MarkdownContent />
						</div>
					)}

				{isTutorialIndex ? (
					<div class="series-layout">
						<aside class="series-rail">
							<span class="series-rail-index" aria-hidden="true">
								{String(chapters.length).padStart(2, '0')}
							</span>
							<h2>{isEnglish ? 'Learning path' : '学习路径'}</h2>
							{MarkdownContent ? (
								<div class="series-rail-intro">
									<MarkdownContent />
								</div>
							) : (
								<p class="series-rail-intro">{description}</p>
							)}
							{chapters[0] && (
								<a class="series-rail-start" href={chapters[0].route}>
									{isEnglish ? 'Start here' : '从这里开始'}
									<i class="ph ph-arrow-right" aria-hidden="true" />
								</a>
							)}
							{otherSeries.length > 0 && (
								<div class="series-rail-others">
									<p>{isEnglish ? 'MORE SERIES' : '其他教程系列'}</p>
									{otherSeries.map((series) => (
										<a href={series.href}>
											{series.title}
											<span>
												{series.count} {isEnglish ? 'ch.' : '章'}
											</span>
										</a>
									))}
								</div>
							)}
						</aside>
						<div class={`series-main content-directory--${record.section}`}>
							<div class="directory-toolbar series-toolbar">
								<label for={`${record.section}-search`}>
									{isEnglish ? 'Search this series' : '搜索本系列'}
								</label>
								<div>
									<i class="ph ph-magnifying-glass" aria-hidden="true" />
									<input
										id={`${record.section}-search`}
										type="search"
										data-directory-query
										placeholder={isEnglish ? 'Title or description' : '标题或简介'}
									/>
								</div>
							</div>
							<ol class="series-chapters" data-directory-list>
								{chapters.map((chapter, index) => (
									<li
										data-directory-item
										data-search={`${chapter.title} ${chapter.description ?? ''}`.toLocaleLowerCase(
											record.locale,
										)}
									>
										<a href={chapter.route}>
											<span class="chapter-num" aria-hidden="true">
												{index + 1}
											</span>
											<span class="chapter-body">
												<span class="chapter-meta">
													{chapter.date && <time datetime={chapter.date}>{chapter.date}</time>}
													<span>
														{chapter.minutes} {isEnglish ? 'min read' : '分钟'}
													</span>
												</span>
												<strong>{chapter.title}</strong>
												{chapter.description && <small>{chapter.description}</small>}
											</span>
										</a>
									</li>
								))}
							</ol>
							<p class="directory-empty" data-directory-empty hidden>
								{isEnglish ? 'No matching chapters.' : '没有匹配的章节。'}
							</p>
						</div>
					</div>
				) : isHighlightsIndex && directoryItems.length > 0 ? (
					<HighlightArchive
						months={highlightMonths}
						years={highlightYearList}
						activeYear={latestHighlightYear}
						locale={record.locale}
						knownRoutes={knownRoutes}
					/>
				) : directoryKind && directoryItems.length > 0 ? (
					<>
						<div class="directory-toolbar">
							<label for={`${directoryKind}-search`}>
								{isEnglish ? 'Search this archive' : '搜索当前归档'}
							</label>
							<div>
								<i class="ph ph-magnifying-glass" aria-hidden="true" />
								<input
									id={
										directoryKind === 'highlights'
											? 'highlight-search'
											: directoryKind === 'model-evals'
												? 'eval-search'
												: `${directoryKind}-search`
									}
									type="search"
									data-directory-query
									placeholder={isEnglish ? 'Title, tag, or description' : '标题、标签或描述'}
								/>
							</div>
						</div>
						<div
							class={`content-directory content-directory--${directoryKind}`}
							data-directory-list
							data-source={directoryKind === 'highlights' ? undefined : `${directoryKind}.json`}
						>
							{directoryItems.map((item) => (
								<DirectoryItemRow item={item} locale={record.locale} knownRoutes={knownRoutes} />
							))}
						</div>
						<p class="directory-empty" data-directory-empty hidden>
							{isEnglish ? 'No matching records.' : '没有匹配的记录。'}
						</p>
					</>
				) : children.length > 0 ? (
					<div class="editorial-archive">
						{children.map((child) => (
							<article>
								<time datetime={child.date?.toISOString()}>
									{child.date?.toISOString().slice(0, 10) ?? 'ARCHIVE'}
								</time>
								<div>
									<h2>
										<a href={child.route}>{child.title}</a>
									</h2>
									{child.description && <p>{child.description}</p>}
								</div>
							</article>
						))}
					</div>
				) : null}
			</section>
		) : isImageCompressor ? (
			<ImageCompressTool locale={record.locale} title={title} description={description} />
		) : isAIInfographic ? (
			<AIInfographicTool locale={record.locale} title={title} description={description} />
		) : (
			<article class="article-shell legacy-article">
				<header class="article-header">
					<p class="page-kicker">{label.kicker}</p>
					<h1>{title}</h1>
					{description && <p class="article-lede">{description}</p>}
					<dl class="article-facts" style={`--article-fact-columns: ${articleFactCount}`}>
						{record.date && (
							<div>
								<dt>{isEnglish ? 'Published' : '发布于'}</dt>
								<dd>
									<time datetime={record.date.toISOString()}>
										{record.date.toISOString().slice(0, 10)}
									</time>
								</dd>
							</div>
						)}
						<div>
							<dt>{isEnglish ? 'Collection' : '所属栏目'}</dt>
							<dd>
								<a href={sectionHref}>{isEnglish ? label.en : label.zh}</a>
							</dd>
						</div>
						<div>
							<dt>{isEnglish ? 'Reading time' : '阅读时间'}</dt>
							<dd>
								{readingMinutes} {isEnglish ? 'min' : '分钟'}
							</dd>
						</div>
						{sourceUrl && (
							<div>
								<dt>{isEnglish ? 'Source' : '资料来源'}</dt>
								<dd>
									<a href={sourceUrl} target="_blank" rel="noreferrer">
										{sourceLabel}
										<i class="ph ph-arrow-up-right" aria-hidden="true" />
									</a>
								</dd>
							</div>
						)}
					</dl>
					{articleTags.length > 0 && (
						<ul class="article-tags" aria-label={isEnglish ? 'Topics' : '主题标签'}>
							{articleTags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)}
				</header>
				<div
					class:list={[
						'article-layout',
						{ 'article-layout--with-outline': outlineHeadings.length > 0 },
					]}
				>
					<div class="article-main">
						{isStandaloneHtml ? (
							<iframe
								class="standalone-article"
								title={title}
								src={standaloneSrc ?? undefined}
								sandbox="allow-scripts allow-same-origin"
								loading="lazy"
							/>
						) : MarkdownContent ? (
							<div class="article-content">
								<MarkdownContent />
							</div>
						) : (
							<p class="article-empty">
								{isEnglish
									? 'This archive entry has no body content yet.'
									: '这条归档目前还没有正文。'}
							</p>
						)}
						{threadId && <Discussion threadId={threadId} locale={record.locale} />}
						<nav
							class="article-pagination"
							aria-label={isEnglish ? 'Article navigation' : '文章导航'}
						>
							<div>
								{newer && (
									<>
										<span>{isEnglish ? 'Newer' : '较新'}</span>
										<a href={newer.route}>← {newer.title}</a>
									</>
								)}
							</div>
							<a class="article-back" href={sectionHref}>
								{isEnglish ? 'Back to archive' : '返回归档'}
							</a>
							<div>
								{older && (
									<>
										<span>{isEnglish ? 'Older' : '较早'}</span>
										<a href={older.route}>{older.title} →</a>
									</>
								)}
							</div>
						</nav>
					</div>
					{outlineHeadings.length > 0 && (
						<ArticleOutline headings={outlineHeadings} locale={record.locale} />
					)}
				</div>
			</article>
		)
	}
</BaseLayout>

{
	/* Bundled from astro/src/scripts (see the header note there); the script
    no-ops on pages without [data-directory-page], so it can load on every
    legacy page. */
}
<script>
	import '../scripts/legacy-directory.js';
	import '../scripts/article-outline.ts';
</script>
