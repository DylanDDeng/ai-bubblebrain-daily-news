---
import type { VibeCodingConcept } from '../data/vibeCodingTerms';
import type { VibeCodingDetailProfile } from '../data/vibeCodingTermDetails';
import '../styles/vibe-coding-flow-lab.css';

interface Props {
	concept: VibeCodingConcept;
	profile: VibeCodingDetailProfile;
}

const { concept, profile } = Astro.props;
const isComponent = concept.id === 'component';
const isState = concept.id === 'state';
const isProps = concept.id === 'props';
const isResponsive = concept.id === 'responsive-design';
const isDom = concept.id === 'dom';
const isHydration = concept.id === 'hydration';
const isEvent = concept.id === 'event';
const isRouting = concept.id === 'routing';
const isSsr = concept.id === 'ssr';
const isStorage = concept.id === 'browser-storage';
const isBackendLab = concept.id === 'backend';
const isApi = concept.id === 'api';
const isEndpoint = concept.id === 'endpoint';
const isRuntimeLab = concept.id === 'runtime';
const isMwLab = concept.id === 'middleware';
const isAuthLab = concept.id === 'authentication';
const isEnvLab = concept.id === 'environment-variable';
const isPromptLab = concept.id === 'prompt';
const isAgentLab = concept.id === 'agent';
const isVibeLab = concept.id === 'vibe-coding';
const isWindowLab = concept.id === 'context-window';
const isTokenLab = concept.id === 'token';
const isHarnessLab = concept.id === 'harness';
const isMcpLab = concept.id === 'mcp';
const isSkillLab = concept.id === 'skill';
const isRagLab = concept.id === 'rag';
const isDbLab = concept.id === 'database';
const isSchemaLab = concept.id === 'schema';
const isMigrationLab = concept.id === 'migration';
const isCacheLab = concept.id === 'cache';
const isVectorLab = concept.id === 'vector-database';
const isDataLab = concept.id === 'data-storage';
const isGitLab = concept.id === 'git';
const isDiffLab = concept.id === 'diff';
const isCommitLab = concept.id === 'commit';
const isBranchLab = concept.id === 'branch';
const isWorktreeLab = concept.id === 'worktree';
const isForkLab = concept.id === 'fork';
const isPrLab = concept.id === 'pull-request';
const isCheckpointLab = concept.id === 'checkpoint';
const isBuildLab = concept.id === 'build';
const isCiLab = concept.id === 'ci-cd';
const isServerlessLab = concept.id === 'serverless';
const isEdgeLab = concept.id === 'edge-runtime';
const isObsLab = concept.id === 'observability';
const isEngLab = concept.id === 'engineering-workflow';
const isDeployLab = concept.id === 'deployment-runtime';
const customLabIds = new Set([
	'prompt',
	'agent',
	'vibe-coding',
	'context-window',
	'token',
	'harness',
	'mcp',
	'skill',
	'rag',
	'database',
	'schema',
	'migration',
	'cache',
	'vector-database',
	'data-storage',
	'git',
	'diff',
	'commit',
	'branch',
	'worktree',
	'fork',
	'pull-request',
	'checkpoint',
	'engineering-workflow',
	'build',
	'ci-cd',
	'serverless',
	'edge-runtime',
	'observability',
	'deployment-runtime',
	'backend',
	'api',
	'endpoint',
	'runtime',
	'middleware',
	'authentication',
	'environment-variable',
	'component',
	'state',
	'props',
	'responsive-design',
	'dom',
	'hydration',
	'event',
	'routing',
	'ssr',
	'browser-storage',
]);
const isFrontend = !customLabIds.has(concept.id) && concept.categoryId === 'frontend';

const labTitles: Record<string, string> = {
	component: '一个按钮组件，怎样复用出整个页面？',
	state: '点一下按钮，状态经历了什么？',
	props: '同一个按钮，怎么被传成不同样子？',
	'responsive-design': '拖一拖屏宽，页面怎么变？',
	dom: '改一个节点，页面哪里会动？',
	hydration: '同一个按钮，水合前后差在哪？',
	api: '调一次天气 API，会发生什么？',
	endpoint: '一个地址，怎么装下查和建？',
	runtime: '同一行代码，插在哪个运行时上？',
	middleware: '一个请求，要过几道公用的关？',
	authentication: '登录之后，系统凭什么一直认得你？',
	'environment-variable': '一份代码，怎么在两个环境各连各的库？',
	event: '点一下按钮，谁在听？',
	routing: '换一个地址，会打开哪一页？',
	ssr: 'CSR 和 SSR，首屏差在哪？',
	'browser-storage': '存一条数据，刷新后还在吗？',
	prompt: '同一个愿望，怎么说才不跑偏？',
	frontend: '一个页面是怎样做出来的？',
	backend: '一次请求会经过哪些部分？',
	agent: 'Model 和 Harness，怎样搭档完成任务？',
	'vibe-coding': '同样的需求，一口气说完还是一轮轮调？',
	'context-window': '聊到第 60 轮，开头的约定还在吗？',
	token: '「帮我总结这份报告」发出去，模型收到的是什么？',
	harness: '模型说「删了它」，框架照做吗？',
	mcp: '接入一个工单系统，要写几遍代码？',
	skill: '每周都要发的周报，怎么不用每次重新教？',
	rag: '模型没学过的问题，怎么答对？',
	database: '重启服务器，注册的用户还在吗？',
	schema: '同一批数据，为什么有结构才算得动？',
	migration: 'users 表要加一列，怎么改才不出事故？',
	cache: '同一个榜单被打开一万次，都要现算吗？',
	'vector-database': '换个说法提问，库里的答案还找得到吗？',
	git: '让 AI 大改代码之前，你的退路在哪？',
	diff: 'AI 说「只改了按钮」，事实是吗？',
	commit: '一天的修改，怎么提交才不给自己埋雷？',
	branch: 'AI 重构到一半，线上要修急 bug，怎么办？',
	worktree: '你和 Agent 同时要改代码，一个目录够用吗？',
	fork: '别人的仓库你没有写权限，想改怎么办？',
	'pull-request': 'AI 的大改动，直接进主线还是先过评审？',
	checkpoint: '让 Agent 连干三小时，你最多会亏掉多少？',
	build: '写好的代码，怎么变成线上能跑的东西？',
	'ci-cd': '每次发布五道工序，漏一步就出事，怎么办？',
	serverless: '一个小工具要上线，服务器谁来操心？',
	'edge-runtime': '同一个网站，东京用户为什么慢出两秒？',
	observability: '凌晨两点支付挂了，你什么时候能知道？',
	'ai-agent': 'AI 工具怎样把目标变成结果？',
	'data-storage': '一杯拿铁的订单，怎样被存进去、又取回来？',
	'engineering-workflow': 'AI 修了一个登录 bug，这笔改动怎样安全进入主线？',
	'deployment-runtime': '一个作品集网站，怎样从你的电脑走到线上？',
};

const stageNames: Record<string, string[]> = {
	component: ['定义', '配置', '组合', '复用'],
	state: ['初始', '事件', '更新', '渲染'],
	props: ['准备', '传入', '读取', '呈现'],
	'responsive-design': ['内容', '断点', '布局', '适配'],
	dom: ['标签', '成树', '查找', '修改'],
	hydration: ['直出', '加载', '接线', '激活'],
	api: ['约定', '调用', '返回', '使用'],
	endpoint: ['地址', '方法', '参数', '处理'],
	runtime: ['代码', '环境', '能力', '执行'],
	middleware: ['进入', '鉴权', '记录', '抵达'],
	authentication: ['声明', '核验', '发证', '通行'],
	'environment-variable': ['占位', '保管', '注入', '切换'],
	event: ['触发', '监听', '处理', '反应'],
	routing: ['地址', '匹配', '渲染', '跳转'],
	ssr: ['请求', '拼装', '送达', '接力'],
	'browser-storage': ['写入', '留存', '读取', '边界'],
	prompt: ['目标', '上下文', '约束', '验收'],
	frontend: ['结构', '样式', '交互', '呈现'],
	backend: ['请求', '校验', '处理', '响应'],
	agent: ['目标', '模型', '框架', '循环'],
	'vibe-coding': ['意图', '生成', '运行', '反馈'],
	'context-window': ['进入', '装满', '压缩', '固定'],
	token: ['输入', '查表', '编号', '后果'],
	harness: ['组装', '决策', '执行', '回填'],
	mcp: ['封装', '连接', '发现', '调用'],
	skill: ['沉淀', '打包', '触发', '复用'],
	rag: ['提问', '检索', '组装', '作答'],
	database: ['写入', '落盘', '查询', '更新'],
	schema: ['定义', '写入', '校验', '使用'],
	migration: ['变化', '成稿', '执行', '回退'],
	cache: ['请求', '查缓存', '回源', '命中'],
	'vector-database': ['嵌入', '入库', '提问', '匹配'],
	git: ['看管', '存档', '对比', '回退'],
	diff: ['修改', '对比', '标记', '审查'],
	commit: ['挑选', '说明', '入册', '回溯'],
	branch: ['开出', '修改', '验证', '汇入'],
	worktree: ['开辟', '分工', '并行', '收拢'],
	fork: ['复刻', '修改', '同步', '回馈'],
	'pull-request': ['发起', '检查', '评审', '合入'],
	checkpoint: ['稳定', '固定', '推进', '回退'],
	build: ['备料', '转换', '打包', '产出'],
	'ci-cd': ['触发', '测试', '构建', '部署'],
	serverless: ['编写', '托管', '伸缩', '计费'],
	'edge-runtime': ['分发', '接入', '执行', '响应'],
	observability: ['记录', '度量', '报警', '追查'],
	'ai-agent': ['目标', '上下文', '工具', '验证'],
	'data-storage': ['定义', '写入', '查询', '返回'],
	'engineering-workflow': ['编辑', '差异', '测试', '提交'],
	'deployment-runtime': ['源码', '构建', '部署', '观察'],
};

const labels =
	stageNames[concept.id] ??
	stageNames[concept.categoryId] ??
	profile.steps.map((step) => step.label);
---

<section class="concept-section" aria-labelledby="concept-flow-title">
	<div class="concept-section-heading">
		<p class="concept-section-index">02 · 点击演示</p>
		<h2 id="concept-flow-title">
			{labTitles[concept.id] ?? labTitles[concept.categoryId] ?? profile.visualTitle}
		</h2>
		<p>突出显示的部分，就是当前概念在整条流程中负责的位置。</p>
	</div>

	<div
		class="concept-process-demo"
		data-concept-flow-lab
		data-active-step="0"
		style="--flow-progress: 0%"
	>
		<ol class="concept-process-panels">
			{
				profile.steps.map((step, index) => (
					<li data-flow-step-item data-state={index === 0 ? 'active' : 'idle'}>
						<article class="concept-process-panel">
							<button
								type="button"
								class="concept-process-panel-select"
								data-flow-step
								data-step-index={index}
								data-step-label={step.label}
								data-step-detail={step.detail}
								aria-pressed={index === 0 ? 'true' : 'false'}
							>
								<header>
									<span>{String(index + 1).padStart(2, '0')}</span>
									<strong>
										{step.label} · {labels[index]}
									</strong>
								</header>
							</button>

							<div class="concept-process-panel-body">
								{isPromptLab && index === 0 ? (
									<div class="concept-lab-pick" data-flow-choice-target="pr" data-choice-pr="vague">
										<div class="concept-props-choices" role="group" aria-label="选择提示词的说法">
											<button
												type="button"
												data-flow-choice="vague"
												data-flow-choice-group="pr"
												aria-pressed="true"
											>
												随口一说
											</button>
											<button
												type="button"
												data-flow-choice="clear"
												data-flow-choice-group="pr"
												aria-pressed="false"
											>
												说清楚
											</button>
										</div>
										<div class="pr-when-vague concept-component-def">
											<small>你发给 AI 的话</small>
											<p>
												<code>需求</code>
												<span>「帮我弄个深色模式」</span>
											</p>
										</div>
										<div class="pr-when-clear concept-component-def">
											<small>你发给 AI 的话</small>
											<p>
												<code>目标</code>
												<span>设置页加一个深色模式开关</span>
											</p>
										</div>
									</div>
								) : null}

								{isPromptLab && index === 1 ? (
									<div class="concept-lab-pick" data-flow-choice-target="pr" data-choice-pr="vague">
										<div class="pr-when-vague concept-js-preview">
											<p>AI：这项目用什么写的？</p>
											<i class="ph ph-arrow-down" aria-hidden="true" />
											<p>没说——那就按最常见的猜一个</p>
										</div>
										<div class="pr-when-clear concept-component-def">
											<small>你补充的背景</small>
											<p>
												<code>技术栈</code>
												<span>Astro + 原生 CSS</span>
											</p>
											<p>
												<code>主题变量</code>
												<span>已有 theme.css</span>
											</p>
										</div>
									</div>
								) : null}

								{isPromptLab && index === 2 ? (
									<div class="concept-lab-pick" data-flow-choice-target="pr" data-choice-pr="vague">
										<div class="pr-when-vague concept-bk-verdict is-block">
											<i class="ph ph-warning" aria-hidden="true" />
											没划边界——AI 顺手把全站样式都动了
										</div>
										<div class="pr-when-clear concept-bk-verdict is-pass">
											<i class="ph ph-shield-check" aria-hidden="true" />
											「只改设置页」——其余文件一行不动
										</div>
									</div>
								) : null}

								{isPromptLab && index === 3 ? (
									<div class="concept-lab-pick" data-flow-choice-target="pr" data-choice-pr="vague">
										<div class="pr-when-vague concept-bk-resp is-400">
											<b>返工</b>
											<span>整站变黑，刷新还原</span>
											<small>没写验收标准，只能凭感觉再来一轮</small>
										</div>
										<div class="pr-when-clear concept-bk-resp is-200">
											<b>通过</b>
											<span>开关生效，刷新后保持</span>
											<small>验收写在提示词里，结果可以被检查</small>
										</div>
									</div>
								) : null}

								{isAgentLab && index === 0 ? (
									<div class="concept-lab-pick" data-flow-choice-target="ag" data-choice-ag="full">
										<div class="concept-props-choices" role="group" aria-label="选择 Agent 的配置">
											<button
												type="button"
												data-flow-choice="full"
												data-flow-choice-group="ag"
												aria-pressed="true"
											>
												Model + Harness
											</button>
											<button
												type="button"
												data-flow-choice="model"
												data-flow-choice-group="ag"
												aria-pressed="false"
											>
												只有 Model
											</button>
										</div>
										<div class="concept-component-def">
											<small>接到的任务</small>
											<p>
												<code>目标</code>
												<span>把失败的测试修好</span>
											</p>
											<p>
												<code>验收</code>
												<span>npm test 全绿</span>
											</p>
										</div>
									</div>
								) : null}

								{isAgentLab && index === 1 ? (
									<div class="concept-lab-pick" data-flow-choice-target="ag" data-choice-ag="full">
										<div class="ag-when-full concept-js-preview">
											<p>Model：先跑一遍测试看看</p>
											<i class="ph ph-arrow-down" aria-hidden="true" />
											<p>下一步动作：npm test</p>
										</div>
										<div class="ag-when-model concept-js-preview">
											<p>Model：先跑一遍测试看看</p>
											<i class="ph ph-arrow-down" aria-hidden="true" />
											<p>可它没有手——命令发给谁？</p>
										</div>
									</div>
								) : null}

								{isAgentLab && index === 2 ? (
									<div class="concept-lab-pick" data-flow-choice-target="ag" data-choice-ag="full">
										<div class="ag-when-full concept-js-preview">
											<p>$ npm test</p>
											<i class="ph ph-arrow-down" aria-hidden="true" />
											<p>1 failed · 输出原样递回 Model</p>
										</div>
										<div class="ag-when-model concept-bk-skip">
											这一步没人接——
											<br />
											没有 Harness，动作只停在文字里
										</div>
									</div>
								) : null}

								{isAgentLab && index === 3 ? (
									<div class="concept-lab-pick" data-flow-choice-target="ag" data-choice-ag="full">
										<div class="ag-when-full concept-bk-resp is-200">
											<b>完成</b>
											<span>改完重跑，测试全绿</span>
											<small>每一步都有真实输出作证据</small>
										</div>
										<div class="ag-when-model concept-bk-resp is-400">
											<b>建议</b>
											<span>「你可以试试改 utils.js」</span>
											<small>只有 Model 就只是聊天——差的那半正是 Harness</small>
										</div>
									</div>
								) : null}

								{isVibeLab && index === 0 ? (
									<div class="concept-lab-pick" data-flow-choice-target="vc" data-choice-vc="once">
										<div class="concept-props-choices" role="group" aria-label="选择提需求的节奏">
											<button
												type="button"
												data-flow-choice="once"
												data-flow-choice-group="vc"
												aria-pressed="true"
											>
												一口气说完
											</button>
											<button
												type="button"
												data-flow-choice="loop"
												data-flow-choice-group="vc"
												aria-pressed="false"
											>
												一轮轮调
											</button>
										</div>
										<div class="vc-when-once concept-component-def">
											<small>你说</small>
											<p>
												<code>需求</code>
												<span>「卡片列表，要阴影、动效、深色模式、还能拖拽」</span>
											</p>
										</div>
										<div class="vc-when-loop concept-component-def">
											<small>你说</small>
											<p>
												<code>需求</code>
												<span>「先来个卡片列表」</span>
											</p>
										</div>
									</div>
								) : null}

								{isVibeLab && index === 1 ? (
									<div class="concept-lab-pick" data-flow-choice-target="vc" data-choice-vc="once">
										<div class="vc-when-once concept-js-preview">
											<p>AI 一次改了 9 个文件</p>
											<i class="ph ph-arrow-down" aria-hidden="true" />
											<p>哪行对应哪个需求？很难说</p>
										</div>
										<div class="vc-when-loop concept-js-preview">
											<p>AI 只改了 1 个文件</p>
											<i class="ph ph-arrow-down" aria-hidden="true" />
											<p>这轮只做列表，别的以后说</p>
										</div>
									</div>
								) : null}

								{isVibeLab && index === 2 ? (
									<div class="concept-lab-pick" data-flow-choice-target="vc" data-choice-vc="once">
										<div class="vc-when-once concept-bk-verdict is-block">
											<i class="ph ph-warning" aria-hidden="true" />
											跑起来：拖拽把动效弄坏了——坏在哪句？
										</div>
										<div class="vc-when-loop concept-bk-verdict is-pass">
											<i class="ph ph-check-circle" aria-hidden="true" />
											跑起来：列表正常——这一步稳了
										</div>
									</div>
								) : null}

								{isVibeLab && index === 3 ? (
									<div class="concept-lab-pick" data-flow-choice-target="vc" data-choice-vc="once">
										<div class="vc-when-once concept-bk-resp is-400">
											<b>难调</b>
											<span>只能整段重说，或者钻进代码</span>
											<small>一大坨变化，定位不了是哪句话的锅</small>
										</div>
										<div class="vc-when-loop concept-bk-resp is-200">
											<b>继续</b>
											<span>「下一步：加悬停动效」</span>
											<small>小步快跑，每句话的效果都看得见</small>
										</div>
									</div>
								) : null}

