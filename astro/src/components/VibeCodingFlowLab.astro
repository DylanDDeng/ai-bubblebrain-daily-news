													data-flow-editor="button-label"
													maxlength="10"
													autocomplete="off"
													spellcheck="false"
												/>
											</p>
										</div>
										<div class="concept-css-preview">
											<p>
												<input
													type="color"
													value="#ff5c50"
													aria-label="修改按钮主色"
													data-flow-style-editor="--preview-accent"
												/>
												<span>color</span>
												<output data-flow-style-value="--preview-accent">#FF5C50</output>
											</p>
										</div>
									</div>
								) : null}

								{isComponent && index === 2 ? (
									<div class="concept-component-compose">
										<p>
											<span>导航栏</span>
											<b>Button</b>
										</p>
										<p>
											<span>文章卡片</span>
											<b>Button</b>
										</p>
										<p>
											<span>登录表单</span>
											<b>Button</b>
										</p>
									</div>
								) : null}

								{isComponent && index === 3 ? (
									<div
										class="concept-browser-preview concept-component-preview"
										data-flow-browser-preview
										style="--preview-text: #151515; --preview-accent: #ff5c50; --preview-spacing: 14px"
									>
										<small>同一个 Button · 三个位置</small>
										<div>
											<span>导航栏</span>
											<button
												type="button"
												data-flow-demo-button
												data-flow-preview="button-label"
												disabled
											>
												加入购物车
											</button>
										</div>
										<div>
											<span>文章卡片</span>
											<button
												type="button"
												data-flow-demo-button
												data-flow-preview="button-label"
												disabled
											>
												加入购物车
											</button>
										</div>
										<div>
											<span>登录表单</span>
											<button
												type="button"
												data-flow-demo-button
												data-flow-preview="button-label"
												disabled
											>
												加入购物车
											</button>
										</div>
										<output data-flow-demo-output>等待 JavaScript</output>
									</div>
								) : null}

								{isFrontend && index === 0 ? (
									<div class="concept-html-preview">
										<p>
											<code>&lt;h1&gt;</code>
											<input
												type="text"
												value="欢迎来到知识库"
												aria-label="修改页面标题"
												data-flow-editor="heading"
												maxlength="18"
												autocomplete="off"
												spellcheck="false"
											/>
										</p>
										<p>
											<code>&lt;p&gt;</code>
											<input
												type="text"
												value="结构、样式和交互已经组合。"
												aria-label="修改页面说明"
												data-flow-editor="description"
												maxlength="28"
												autocomplete="off"
												spellcheck="false"
											/>
										</p>
										<p>
											<code>&lt;button&gt;</code>
											<input
												type="text"
												value="点我试试"
												aria-label="修改按钮文字"
												data-flow-editor="button"
												maxlength="10"
												autocomplete="off"
												spellcheck="false"
											/>
										</p>
									</div>
								) : null}

								{isFrontend && index === 1 ? (
									<div class="concept-css-preview">
										<p>
											<input
												type="color"
												value="#151515"
												aria-label="修改文字颜色"
												data-flow-style-editor="--preview-text"
