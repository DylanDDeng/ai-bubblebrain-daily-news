							<div class="ps-tt-form" aria-hidden="true">
								<span class="ps-tt-field">
									<b>
										套餐
										<label
											class="pattern-spot-region ps-tt-tip"
											for={`spot-${concept.id}-tooltip`}
											data-pick-option="tooltip"
											aria-label="气泡提示"
										>
											<span class="ps-tt-bubble">每月自动续费，可随时取消</span>
											<i class="ph ph-question" />
										</label>
									</b>
									<i />
								</span>
								<span class="ps-tt-field">
									<b>发票抬头</b>
									<i />
								</span>
							</div>
							<label
								class="pattern-spot-region ps-tt-toast"
								for={`spot-${concept.id}-toast`}
								data-pick-option="toast"
								aria-label="轻提示"
							>
								<i class="ph ph-check-circle" />
								已保存
							</label>
						</div>
					) : isCommandPalette ? (
						<div class="pattern-spot-mock ps-cp-stage">
							{profile.spot.regions.map((region) => (
								<input
									class="pattern-pick-input"
									type="radio"
									name={`spot-${concept.id}`}
									id={`spot-${concept.id}-${region.id}`}
									value={region.id}
								/>
							))}
							<div class="ps-cp-bar" aria-hidden="true">
								<b />
								<i />
								<i />
								<label
									class="pattern-spot-region ps-cp-search"
									for={`spot-${concept.id}-search`}
									data-pick-option="search"
									aria-label="搜索框"
								>
									<i class="ph ph-magnifying-glass" />
									搜索文章…
								</label>
							</div>
							<div class="ps-cp-body" aria-hidden="true">
								<label
									class="pattern-spot-region ps-cp-select"
									for={`spot-${concept.id}-select`}
									data-pick-option="select"
									aria-label="下拉选择"
								>
									全部分类
									<i class="ph ph-caret-down" />
								</label>
								<span class="ps-cp-lines">
									<i />
									<i />
									<i class="is-short" />
								</span>
							</div>
							<label
								class="pattern-spot-region ps-cp-palette"
								for={`spot-${concept.id}-palette`}
								data-pick-option="palette"
								aria-label="命令面板"
							>
								<span class="ps-cp-palette-input">
									<i class="ph ph-magnifying-glass" />
									<b>新建</b>
									<em>⌘K</em>
								</span>
								<span class="ps-cp-palette-list">
									<i class="is-active">
										<u class="ph ph-plus" />
										新建文档
									</i>
									<i>
										<u class="ph ph-folder-plus" />
										新建文件夹
									</i>
									<i>
										<u class="ph ph-file-text" />
										新手入门
									</i>
								</span>
							</label>
						</div>
					) : isAlert ? (
						<div class="pattern-spot-mock ps-al-stage">
							{profile.spot.regions.map((region) => (
								<input
									class="pattern-pick-input"
									type="radio"
									name={`spot-${concept.id}`}
									id={`spot-${concept.id}-${region.id}`}
									value={region.id}
								/>
							))}
							<label
								class="pattern-spot-region ps-al-banner"
								for={`spot-${concept.id}-alert`}
								data-pick-option="alert"
								aria-label="警告横幅"
							>
								<i class="ph ph-warning" />
								<b>邮箱尚未验证</b>
								<em>去验证</em>
							</label>
							<div class="ps-al-dim" aria-hidden="true">
								<span />
								<span class="is-short" />
								<span />
								<span class="is-short" />
							</div>
							<label
								class="pattern-spot-region ps-al-modal"
								for={`spot-${concept.id}-modal`}
								data-pick-option="modal"
								aria-label="弹窗"
							>
								<b>确认退出登录？</b>
								<span>
									<em>取消</em>
									<em class="is-primary">退出</em>
								</span>
							</label>
							<label
								class="pattern-spot-region ps-al-toast"
								for={`spot-${concept.id}-toast`}
								data-pick-option="toast"
								aria-label="轻提示"
							>
								<i class="ph ph-check-circle" />
								已复制
							</label>
						</div>
					) : null}
					<div class="pattern-spot-panel">
						<p class="pattern-spot-hint" data-pick-note="">
							<i class="ph ph-cursor-click" aria-hidden="true" />
							点一块试试，看看它叫什么
						</p>
						{profile.spot.regions.map((region) => (
							<div
								class="pattern-spot-note"
								data-pick-note={region.id}
								data-good={region.correct ? 'true' : 'false'}
								hidden
							>
								<strong>
									{region.correct ? (
										<i class="ph ph-check-circle" aria-hidden="true" />
									) : (
										<i class="ph ph-x-circle" aria-hidden="true" />
									)}
									{region.name}
									{region.en ? <small>{region.en}</small> : null}
								</strong>
								<p>{region.note}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		) : null
	}

	<section class="concept-section" aria-labelledby="pattern-usage-title">
		<div class="concept-section-heading">
			<p class="concept-section-index">04 · 用与不用</p>
			<h2 id="pattern-usage-title">什么时候该上它</h2>
		</div>
		<div class="pattern-usage">
			<div class="pattern-usage-card is-fit">
				<span><i class="ph ph-check-circle" aria-hidden="true"></i>适合</span>
				<ul>
					{profile.usage.fit.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="pattern-usage-card is-unfit">
				<span><i class="ph ph-x-circle" aria-hidden="true"></i>先别用</span>
				<ul>
					{profile.usage.unfit.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	{
		profile.quiz ? (
			<section class="concept-section" aria-labelledby="pattern-quiz-title">
				<div class="concept-section-heading">
					<p class="concept-section-index">05 · 想一想</p>
					<h2 id="pattern-quiz-title">一道题，检查眼力</h2>
					<p>{profile.quiz.question}</p>
				</div>
				<div class="pattern-quiz" data-pick>
					{profile.quiz.options.map((option) => (
						<input
							class="pattern-pick-input"
							type="radio"
							name={`quiz-${concept.id}`}
							id={`quiz-${concept.id}-${option.key}`}
							value={option.key}
						/>
					))}
					{profile.quiz.options.map((option) => (
						<label
							class="pattern-quiz-option"
							for={`quiz-${concept.id}-${option.key}`}
							data-pick-option={option.key}
						>
							<b>{option.key}</b>
							<span>{option.text}</span>
						</label>
					))}
					{profile.quiz.options.map((option) => (
						<p
							class="pattern-quiz-feedback"
							data-pick-note={option.key}
							data-good={option.correct ? 'true' : 'false'}
							hidden
						>
							{option.feedback}
						</p>
					))}
				</div>
			</section>
		) : null
	}

	<section class="concept-section" aria-labelledby="pattern-prompts-title">
		<div class="concept-section-heading">
			<p class="concept-section-index">06 · 说给 AI 听</p>
			<h2 id="pattern-prompts-title">让 AI 改它时，这样说</h2>
			<p>{profile.promptTip}</p>
		</div>
		<div class="pattern-prompts">
			{
				profile.prompts.map((prompt) => (
					<p class="pattern-prompt-bubble">
						<i class="ph ph-chat-circle-text" aria-hidden="true" />
						<span>{prompt}</span>
						<button type="button" data-copy={prompt} aria-label="复制这句话">
							复制
						</button>
					</p>
				))
			}
		</div>
	</section>

	<section class="concept-boundary" aria-labelledby="concept-boundary-title">
		<span>老师提醒</span>
		<div>
			<h2 id="concept-boundary-title">最容易踩的坑</h2>
			<p>{profile.warning}</p>
		</div>
	</section>

	<nav class="concept-detail-pagination" aria-label="相邻术语">
		{
			previousConcept ? (
				<a href={`/vibe-coding/terms/${previousConcept.id}/`} rel="prev">
					<span>上一个</span>
					<strong>{previousConcept.chineseName}</strong>
				</a>
			) : null
		}
		{
			nextConcept ? (
				<a href={`/vibe-coding/terms/${nextConcept.id}/`} rel="next">
					<span>下一个</span>
					<strong>{nextConcept.chineseName}</strong>
				</a>
			) : null
		}
	</nav>
</article>

<script is:inline type="module" src="/js/vibe-coding-pattern-detail.js"></script>
