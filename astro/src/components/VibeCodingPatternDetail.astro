---
import type { VibeCodingConcept } from '../data/vibeCodingTerms';
import type { VibeCodingPatternProfile } from '../data/vibeCodingPatternDetails';
import '../styles/vibe-coding-term-detail.css';
import '../styles/vibe-coding-pattern-detail.css';

interface Props {
	concept: VibeCodingConcept;
	profile: VibeCodingPatternProfile;
	previousConcept: VibeCodingConcept | null;
	nextConcept: VibeCodingConcept | null;
}

const { concept, profile, previousConcept, nextConcept } = Astro.props;
const isHero = concept.id === 'hero';
const isNavbar = concept.id === 'navbar';
const isFooter = concept.id === 'footer';
const isCard = concept.id === 'card';
const isModal = concept.id === 'modal';
const isToast = concept.id === 'toast';
const isForm = concept.id === 'form';
const isTabs = concept.id === 'tabs';
const isSlider = concept.id === 'slider';
const isInput = concept.id === 'input';
const isSelect = concept.id === 'select';
const isToggle = concept.id === 'toggle';
const isDrawer = concept.id === 'drawer';
const isSkeleton = concept.id === 'skeleton';
const isEmpty = concept.id === 'empty-state';
const isBadge = concept.id === 'badge';
const isBreadcrumb = concept.id === 'breadcrumb';
const isPagination = concept.id === 'pagination';
const isSidebar = concept.id === 'sidebar';
const isSection = concept.id === 'section';
const isAlert = concept.id === 'alert';
const isCommandPalette = concept.id === 'command-palette';
const isTooltip = concept.id === 'tooltip';
const isDropdownMenu = concept.id === 'dropdown-menu';
const isInfiniteScroll = concept.id === 'infinite-scroll';
const isStepper = concept.id === 'stepper';
const isProgressBar = concept.id === 'progress-bar';
const isSpinner = concept.id === 'spinner';
const isCheckbox = concept.id === 'checkbox';
const isButton = concept.id === 'button';
const isAccordion = concept.id === 'accordion';
const isTable = concept.id === 'table';
const isCtrlGroup = isInput || isSelect || isToggle;
const isWayGroup = isBreadcrumb || isPagination || isSidebar;
const isStatusGroup = isSkeleton || isEmpty || isBadge || isSpinner;
---

<article class="concept-detail" data-vibe-coding-term-detail={concept.id}>
	<a class="concept-detail-back" href={`/vibe-coding/terms/#${concept.categoryId}`}>
		<i class="ph ph-arrow-left" aria-hidden="true"></i>
		返回术语
	</a>

	<header class="concept-detail-hero">
		<p>{concept.categoryLabel}</p>
		<h1>
			{concept.chineseName}
			<span>{concept.name}</span>
		</h1>
		<div class="concept-detail-qa">
			<div class="concept-qa-row concept-qa-question">
				<span class="concept-qa-glyph" aria-hidden="true">Q</span>
				<div class="concept-qa-body">
					<span class="concept-qa-label">你可能会问</span>
					<p>
						<em>{concept.chineseName}</em>{profile.question}
					</p>
				</div>
			</div>
			<div class="concept-qa-row concept-qa-answer">
				<span class="concept-qa-glyph" aria-hidden="true">A</span>
				<div class="concept-qa-body">
					<span class="concept-qa-label">简单来说</span>
					<p>{concept.description}</p>
				</div>
			</div>
		</div>
	</header>

	<section class="concept-section" aria-labelledby="pattern-anatomy-title">
		<div class="concept-section-heading">
			<p class="concept-section-index">01 · 拆开看看</p>
			<h2 id="pattern-anatomy-title">这一块由什么组成</h2>
			<p>{profile.anatomyIntro}</p>
		</div>
		<div class="pattern-anatomy">
			{
				isHero ? (
					<div class="pattern-anatomy-mock" aria-hidden="true">
						<div class="pattern-mock-nav">
							<b />
							<i />
							<i />
							<i />
						</div>
						<div class="pattern-mock-hero">
							<div class="pattern-mock-copy">
								<span class="pattern-mock-eyebrow" data-part-target="1">
									全新 2.0
								</span>
								<span class="pattern-mock-title" data-part-target="2" />
								<span class="pattern-mock-title is-short" data-part-target="2" />
								<span class="pattern-mock-sub" data-part-target="3" />
								<span class="pattern-mock-actions" data-part-target="4">
									<b>开始使用</b>
									<i>查看文档</i>
								</span>
							</div>
							<div class="pattern-mock-visual" data-part-target="5">
								<i class="ph ph-image" />
							</div>
						</div>
						<span class="pattern-part-badge" style="left: 6%; top: 26%;" data-part-target="1">
							1
						</span>
						<span class="pattern-part-badge" style="left: 6%; top: 44%;" data-part-target="2">
							2
						</span>
						<span class="pattern-part-badge" style="left: 6%; top: 63%;" data-part-target="3">
							3
						</span>
						<span class="pattern-part-badge" style="left: 6%; top: 82%;" data-part-target="4">
							4
						</span>
						<span class="pattern-part-badge" style="right: 5%; top: 30%;" data-part-target="5">
							5
						</span>
					</div>
				) : isNavbar ? (
					<div class="pattern-anatomy-mock" aria-hidden="true">
						<div class="pam-nav">
							<b class="pam-nav-logo" data-part-target="1">Bubble</b>
							<span class="pam-nav-links" data-part-target="2">
								<i>产品</i>
								<i>定价</i>
								<i>文档</i>
							</span>
							<em class="pam-nav-action" data-part-target="3">开始使用</em>
							<span class="pam-nav-burger" data-part-target="4">
								<b />
								<b />
								<b />
							</span>
						</div>
						<div class="pam-ghost">
							<span />
							<span />
							<span class="is-short" />
						</div>
						<span class="pattern-part-badge" style="left: 5%; top: 46%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="left: 32%; top: 46%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 21%; top: 46%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 3%; top: 46%;" data-part-target="4">4</span>
					</div>
				) : isFooter ? (
					<div class="pattern-anatomy-mock" aria-hidden="true">
						<div class="pam-ghost is-top">
							<span />
							<span class="is-short" />
						</div>
						<div class="pam-footer">
							<div class="pam-ft-top">
								<span class="pam-ft-brand" data-part-target="1">
									<b>Bubble</b>
									<i />
									<i class="is-short" />
								</span>
								<span class="pam-ft-cols" data-part-target="2">
									<span>
										<b />
										<i />
										<i />
									</span>
									<span>
										<b />
										<i />
										<i />
									</span>
									<span>
										<b />
										<i />
										<i />
									</span>
								</span>
							</div>
							<div class="pam-ft-bottom">
								<span class="pam-ft-legal" data-part-target="4">© 2026 Bubble · 隐私政策</span>
								<span class="pam-ft-social" data-part-target="3">
									<i />
									<i />
									<i />
								</span>
							</div>
						</div>
						<span class="pattern-part-badge" style="left: 4%; top: 34%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 27%; top: 28%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 4%; top: 82%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="left: 4%; top: 82%;" data-part-target="4">4</span>
					</div>
				) : isCard ? (
					<div class="pattern-anatomy-mock pam-card-wrap" aria-hidden="true">
						<div class="pam-card">
							<span class="pam-card-cover" data-part-target="1">
								<i class="ph ph-image" />
							</span>
							<span class="pam-card-title" data-part-target="2">三天上线你的知识库</span>
							<span class="pam-card-desc" data-part-target="3">
								<i />
								<i class="is-short" />
							</span>
							<span class="pam-card-meta" data-part-target="4">
								<i>8 月 24 日</i>
								<i>教程</i>
							</span>
						</div>
						<span class="pattern-part-badge" style="right: 21%; top: 16%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 21%; top: 52%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 21%; top: 68%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 21%; top: 86%;" data-part-target="4">4</span>
					</div>
				) : isModal ? (
					<div class="pattern-anatomy-mock pam-stage" aria-hidden="true">
						<span class="pam-overlay" data-part-target="1" />
						<div class="pam-modal">
							<em class="pam-modal-close" data-part-target="5">×</em>
							<b class="pam-modal-title" data-part-target="2">删除这个项目？</b>
							<span class="pam-modal-body" data-part-target="3">
								<i />
								<i class="is-short" />
							</span>
							<span class="pam-modal-actions" data-part-target="4">
								<em>取消</em>
								<b>删除</b>
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 5%; top: 10%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="left: 24%; top: 30%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 24%; top: 54%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="left: 24%; top: 80%;" data-part-target="4">4</span>
						<span class="pattern-part-badge" style="right: 24%; top: 18%;" data-part-target="5">5</span>
					</div>
				) : isToast ? (
					<div class="pattern-anatomy-mock pam-stage" aria-hidden="true">
						<div class="pam-ghost is-top">
							<span />
							<span class="is-short" />
						</div>
						<div class="pam-toast">
							<i class="ph ph-check-circle pam-toast-icon" data-part-target="1" />
							<b data-part-target="2">已保存到草稿</b>
							<em data-part-target="3">撤销</em>
							<span class="pam-toast-timer" data-part-target="4" />
						</div>
						<span class="pattern-part-badge" style="right: 40%; top: 22%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 22%; top: 22%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 7%; top: 22%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 22%; top: 62%;" data-part-target="4">4</span>
					</div>
				) : isForm ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-form">
							<span class="pam-form-row">
								<b class="pam-form-label" data-part-target="1">邮箱</b>
								<span class="pam-form-input" data-part-target="2">you@example.com</span>
								<i class="pam-form-hint" data-part-target="3">需要真实邮箱，用于找回密码</i>
							</span>
							<span class="pam-form-row">
								<b class="pam-form-label">密码</b>
								<span class="pam-form-input">••••••••</span>
							</span>
							<b class="pam-form-submit" data-part-target="4">创建账号</b>
						</div>
						<span class="pattern-part-badge" style="left: 12%; top: 14%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 12%; top: 28%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 12%; top: 46%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 12%; top: 84%;" data-part-target="4">4</span>
					</div>
				) : isTabs ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-tabs">
							<span class="pam-tab-list" data-part-target="1">
								<i class="is-on" data-part-target="2">介绍</i>
								<i>评价</i>
								<i>参数</i>
							</span>
							<span class="pam-tab-panel" data-part-target="3">
								<i />
								<i />
								<i class="is-short" />
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 12%; top: 8%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="left: 30%; top: 30%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 12%; top: 62%;" data-part-target="3">3</span>
					</div>
				) : isSlider ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-slider">
							<span class="pam-sl-row">
								<span class="pam-sl-track" data-part-target="1">
									<b class="pam-sl-fill" data-part-target="3" />
									<i class="pam-sl-thumb" data-part-target="2" />
								</span>
								<em class="pam-sl-value" data-part-target="4">64</em>
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 14%; top: 26%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="left: 52%; top: 26%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 30%; top: 72%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 10%; top: 26%;" data-part-target="4">4</span>
					</div>
				) : isInput ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-form">
							<span class="pam-form-row">
								<b class="pam-form-label" data-part-target="1">邮箱</b>
								<span class="pam-form-input" data-part-target="2">
									<i class="pam-placeholder" data-part-target="3">you@example.com</i>
								</span>
							</span>
							<span class="pam-form-row">
								<b class="pam-form-label">昵称</b>
								<span class="pam-form-input is-error" data-part-target="4">泡泡%</span>
								<i class="pam-form-hint is-error" data-part-target="4">只能包含字母和数字</i>
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 10%; top: 16%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 10%; top: 30%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 40%; top: 30%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 10%; top: 68%;" data-part-target="4">4</span>
					</div>
				) : isSelect ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-select">
							<span class="pam-select-trigger" data-part-target="1">
								全部分类
								<i class="ph ph-caret-down" data-part-target="2" />
							</span>
							<span class="pam-select-list" data-part-target="3">
								<i class="is-on" data-part-target="4">全部分类</i>
								<i>教程</i>
								<i>随笔</i>
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 16%; top: 16%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 16%; top: 16%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 16%; top: 62%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="left: 16%; top: 46%;" data-part-target="4">4</span>
					</div>
				) : isToggle ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-toggle-stage">
							<span class="pam-toggle is-on">
								<i class="pam-toggle-track" data-part-target="1" />
								<b class="pam-toggle-knob" data-part-target="2" />
							</span>
							<span class="pam-toggle-legend" data-part-target="3">
								<span class="pam-toggle is-mini is-on">
									<i class="pam-toggle-track" />
									<b class="pam-toggle-knob" />
								</span>
								开
								<span class="pam-toggle is-mini">
									<i class="pam-toggle-track" />
									<b class="pam-toggle-knob" />
								</span>
								关
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 24%; top: 22%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 24%; top: 22%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 24%; top: 74%;" data-part-target="3">3</span>
					</div>
				) : isDrawer ? (
					<div class="pattern-anatomy-mock pam-stage" aria-hidden="true">
						<span class="pam-overlay" data-part-target="2" />
						<div class="pam-drawer" data-part-target="1">
							<em class="pam-modal-close" data-part-target="3">×</em>
							<span class="pam-drawer-content" data-part-target="4">
								<i />
								<i />
								<i class="is-short" />
							</span>
						</div>
						<span class="pattern-part-badge" style="right: 30%; top: 14%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="left: 8%; top: 14%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 4%; top: 14%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 30%; top: 62%;" data-part-target="4">4</span>
					</div>
				) : isSkeleton ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-skel" data-part-target="3">
							<span class="pam-skel-cover" data-part-target="1" />
							<span class="pam-skel-bar" data-part-target="1" />
							<span class="pam-skel-bar is-short" data-part-target="1" />
							<i class="pam-shimmer" data-part-target="2" />
						</div>
						<span class="pattern-part-badge" style="left: 18%; top: 26%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 18%; top: 46%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 18%; top: 80%;" data-part-target="3">3</span>
					</div>
				) : isEmpty ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-empty">
							<i class="ph ph-tray pam-empty-icon" data-part-target="1" />
							<b data-part-target="2">还没有任何项目</b>
							<span class="pam-empty-desc" data-part-target="3">创建第一个项目，开始整理你的想法。</span>
							<em data-part-target="4">创建第一个项目</em>
						</div>
						<span class="pattern-part-badge" style="left: 22%; top: 16%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 22%; top: 40%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 22%; top: 58%;" data-part-target="3">3</span>
						<span class="pattern-part-badge" style="right: 22%; top: 82%;" data-part-target="4">4</span>
					</div>
				) : isBadge ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-badge-stage">
							<span class="pam-badge-host">
								<i class="ph ph-bell" data-part-target="1" />
								<em data-part-target="2">3</em>
							</span>
							<span class="pam-badge-legend" data-part-target="3">
								<b class="is-red">红 · 催办</b>
								<b class="is-gray">灰 · 中性</b>
								<b class="is-green">绿 · 在线</b>
							</span>
						</div>
						<span class="pattern-part-badge" style="left: 26%; top: 26%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="right: 30%; top: 12%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="left: 26%; top: 76%;" data-part-target="3">3</span>
					</div>
				) : isBreadcrumb ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-bc">
							<span class="pam-bc-trail" data-part-target="1">
								<b>首页</b>
								<i data-part-target="2">/</i>
								<b>教程</b>
								<i data-part-target="2">/</i>
							</span>
							<em class="pam-bc-current" data-part-target="3">三天上线知识库</em>
						</div>
						<span class="pattern-part-badge" style="left: 12%; top: 66%;" data-part-target="1">1</span>
						<span class="pattern-part-badge" style="left: 43%; top: 20%;" data-part-target="2">2</span>
						<span class="pattern-part-badge" style="right: 12%; top: 66%;" data-part-target="3">3</span>
					</div>
				) : isPagination ? (
					<div class="pattern-anatomy-mock pam-form-wrap" aria-hidden="true">
						<div class="pam-pg">
							<i class="ph ph-caret-left pam-pg-arrow" data-part-target="3" />
							<b data-part-target="1">1</b>
							<b class="is-on" data-part-target="2">2</b>
