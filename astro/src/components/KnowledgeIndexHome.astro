---
import { legacyEntryIsRoutable, loadLegacyContent, type LegacySection } from '../lib/legacyContent';
import { buildKnowledgeSearchIndex } from '../lib/searchIndex';
import { designBrands } from '../data/designBrands';
import { vibeCodingTermCategories } from '../data/vibeCodingTerms';
import '../styles/knowledge-home-v2.css';

interface Props {
	locale: 'zh-CN' | 'en';
}

const { locale } = Astro.props;
const isEnglish = locale === 'en';
const prefix = isEnglish ? '/en' : '';
const entries = (await loadLegacyContent()).filter(
	(entry) =>
		entry.locale === locale &&
		!entry.isIndex &&
		entry.section !== 'about' &&
		entry.section !== 'x-trending' &&
		legacyEntryIsRoutable(entry),
);
const searchIndex = await buildKnowledgeSearchIndex({ locale });

const sectionCopy: Array<{
	section: LegacySection;
	label: string;
	description: string;
}> = isEnglish
	? [
			{
				section: 'highlights',
				label: 'Highlights',
				description: 'Curated primary sources and durable explainers.',
			},
		]
	: [
			{
				section: 'newbie-tutorials',
				label: '新手村',
				description: '写给没有技术背景的读者：用直觉、动图和小实验讲清大模型的基本问题。',
			},
			{
				section: 'codex-tutorials',
				label: 'Codex 教程',
				description: '从入门到实战，系统掌握 Codex 的使用方法。',
			},
			{
				section: 'pi-agent-tutorials',
				label: 'Pi Agent 教程',
				description: '从终端第一步到 Skills 与 Extensions，理解并用好极简 Agent Harness。',
			},
			{
				section: 'workbuddy-tutorials',
				label: 'WorkBuddy 教程',
				description: '从办公协作到自动化，系统掌握 WorkBuddy 的使用方法。',
			},
			{
				section: 'highlights',
				label: '精选阅读',
				description: '值得长期保存的一手资料与深度解读。',
			},
		];

const countFor = (section: LegacySection) =>
	searchIndex.items.filter((entry) => entry.section === section).length;
const designBrandCount = designBrands.length;
const termCount = vibeCodingTermCategories.reduce(
	(sum, category) => sum + category.terms.length,
	0,
);
const articleCount = searchIndex.items.length;
const collectionCount = sectionCopy.length + (isEnglish ? 0 : 1);
const featured = [...entries]
	.sort((left, right) => {
		const featuredOrder =
			Number(right.frontmatter.featured === true) - Number(left.frontmatter.featured === true);
		return featuredOrder || (right.date?.getTime() ?? 0) - (left.date?.getTime() ?? 0);
	})
	.slice(0, 6);
const dateFormatter = new Intl.DateTimeFormat(locale, {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
	timeZone: 'Asia/Shanghai',
});
const labelFor = (section: LegacySection) =>
	sectionCopy.find((item) => item.section === section)?.label ?? section;
---

<section class="kh">
	<header class="kh-hero">
		<div class="kh-hero-copy">
			<p class="kh-eyebrow">{isEnglish ? 'PERSONAL AI KNOWLEDGE BASE' : '个人 AI 知识库'}</p>
			<h1>
				Bubble's <em>Brain</em>
			</h1>
			<p class="kh-lede">
				{
					isEnglish
						? 'Agent tutorials, illustrated glossaries and primary sources worth keeping — for people who build things with AI.'
						: '收录 Agent 教程、Vibe Coding 图解与值得留存的一手资料——写给正在用 AI 做东西的人。'
				}
			</p>
			<a
				class="kh-search"
				href={isEnglish ? '/search/?locale=en' : '/search/'}
				data-command-search-trigger
			>
				<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
				<span>{isEnglish ? 'Search the library…' : '搜点什么，比如「水合」「Endpoint」…'}</span>
				<kbd>⌘K</kbd>
			</a>
			<p class="kh-stats">
				<span><b>{articleCount}</b>{isEnglish ? ' entries' : ' 篇内容'}</span>
				{
					!isEnglish && (
						<span>
							<b>{termCount}</b> 个术语图解
						</span>
					)
				}
				<span><b>{collectionCount}</b>{isEnglish ? ' collections' : ' 个栏目'}</span>
			</p>
		</div>

		<figure class="kh-cat" id="kh-cat-fig" aria-hidden="true">
			<img
				id="kh-cat-img"
				src="/images/brain-cat.jpg"
				alt=""
				loading="eager"
				decoding="async"
				width="1100"
				height="765"
			/>
			<canvas class="kh-eyecanvas" id="kh-cat-canvas"></canvas>
		</figure>
	</header>

	<section id="library" class="kh-section" aria-labelledby={`library-heading-${locale}`}>
		<header class="kh-section-heading">
			<p>{isEnglish ? 'EXPLORE THE LIBRARY' : '浏览知识库'}</p>
			<h2 id={`library-heading-${locale}`}>{isEnglish ? 'Collections' : '知识栏目'}</h2>
		</header>
		<div class="kh-collections">
			{
				sectionCopy.map((item) => (
					<a href={`${prefix}/${item.section}/`} class="kh-collection">
						<h3>
							{item.label}
							<sup>{countFor(item.section)}</sup>
							<i class="ph ph-arrow-up-right" aria-hidden="true" />
						</h3>
						<p>{item.description}</p>
					</a>
				))
			}
			{
				!isEnglish && (
					<a href="/vibe-coding/terms/" class="kh-collection">
						<h3>
							Vibe Coding 术语
							<sup>{termCount}</sup>
							<i class="ph ph-arrow-up-right" aria-hidden="true" />
						</h3>
						<p>把 AI 编程的概念一块一块拆开：图解、比喻加可以上手玩的演示。</p>
					</a>
				)
			}
			{
				!isEnglish && (
					<a href="/vibe-coding/design/" class="kh-collection">
						<h3>
							Vibe Coding Design
							<sup>{designBrandCount}</sup>
							<i class="ph ph-arrow-up-right" aria-hidden="true" />
						</h3>
						<p>大公司写给 AI 编码工具看的 DESIGN.md，逐个品牌拆解色彩、字体与设计哲学。</p>
					</a>
				)
			}
		</div>
	</section>

	<section id="recent" class="kh-section" aria-labelledby={`recent-heading-${locale}`}>
		<header class="kh-section-heading">
			<p>{isEnglish ? 'CURATED & MAINTAINED' : '持续整理与维护'}</p>
			<h2 id={`recent-heading-${locale}`}>{isEnglish ? 'Recently added' : '最近收录'}</h2>
			<a class="kh-more" href="/search/">{isEnglish ? 'Browse all →' : '查看全部 →'}</a>
		</header>
		<div class="kh-recent">
			{
				featured.map((entry, index) => (
					<article class="kh-recent-item">
						<span class="kh-recent-num" aria-hidden="true">
							{index + 1}
						</span>
						<div>
							<p class="kh-recent-meta">
								<span>{labelFor(entry.section)}</span>
								{entry.date && (
									<time datetime={entry.date.toISOString()}>
										{dateFormatter.format(entry.date)}
									</time>
								)}
							</p>
							<h3>
								<a href={entry.route}>{entry.title}</a>
							</h3>
							{entry.description && <p class="kh-recent-desc">{entry.description}</p>}
						</div>
					</article>
				))
			}
		</div>
	</section>
</section>

<script is:inline type="module" src="/js/knowledge-home-v2.js"></script>
