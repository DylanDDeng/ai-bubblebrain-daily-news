---
import type { VibeCodingConcept } from '../data/vibeCodingTerms';
import type { VibeCodingDetailProfile } from '../data/vibeCodingTermDetails';
import VibeCodingConceptVisual from './VibeCodingConceptVisual.astro';
import VibeCodingFlowLab from './VibeCodingFlowLab.astro';
import '../styles/vibe-coding-term-detail.css';

interface Props {
	concept: VibeCodingConcept;
	profile: VibeCodingDetailProfile;
	previousConcept: VibeCodingConcept | null;
	nextConcept: VibeCodingConcept | null;
}

const { concept, profile, previousConcept, nextConcept } = Astro.props;
---

<article class="concept-detail" data-vibe-coding-term-detail={concept.id}>
	<a class="concept-detail-back" href={`/vibe-coding/terms/#${concept.categoryId}`}>
		<i class="ph ph-arrow-left" aria-hidden="true"></i>
		返回术语
	</a>

	<header class="concept-detail-hero">
		<p>{concept.isCategory ? '术语分类' : concept.categoryLabel}</p>
		<h1>
			{concept.chineseName}
			{concept.name !== concept.chineseName ? <span>{concept.name}</span> : null}
		</h1>
		<div class="concept-detail-qa">
			<div class="concept-qa-row concept-qa-question">
				<span class="concept-qa-glyph" aria-hidden="true">Q</span>
				<div class="concept-qa-body">
					<span class="concept-qa-label">你可能会问</span>
					<p>
						<em>{concept.chineseName}</em>{
							profile.question ?? '到底是什么？它在一条完整的开发流程里，负责哪一段？'
						}
					</p>
				</div>
			</div>
			<div class="concept-qa-row concept-qa-answer">
				<span class="concept-qa-glyph" aria-hidden="true">A</span>
				<div class="concept-qa-body">
					<span class="concept-qa-label">简单来说</span>
					<p>{concept.description}</p>
				</div>
			</div>
		</div>
	</header>

	<VibeCodingConceptVisual concept={concept} profile={profile} />

	<section class="concept-explanation" aria-labelledby="concept-understand-title">
		<div class="concept-section-heading">
			<p class="concept-section-index">01 · 先这样理解</p>
			<h2 id="concept-understand-title">把抽象概念放进真实场景</h2>
		</div>
		<div class="concept-explanation-copy">
			<p class="concept-explanation-lead">{concept.description}</p>
			<blockquote>
				<span><i class="ph ph-lightbulb" aria-hidden="true"></i>换个角度想</span>
				<p>{profile.analogy}</p>
			</blockquote>
		</div>
	</section>

	<VibeCodingFlowLab concept={concept} profile={profile} />

	<section class="concept-section" aria-labelledby="concept-scenes-title">
		<div class="concept-section-heading">
			<p class="concept-section-index">03 · 放进真实任务</p>
			<h2 id="concept-scenes-title">什么时候会遇到它</h2>
		</div>
		<div class="concept-scene-list">
			{
				profile.scenes.map((scene, index) => (
					<article>
						<span aria-hidden="true">{index + 1}</span>
						<h3>{scene.title}</h3>
						<p>{scene.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="concept-practice" aria-labelledby="concept-practice-title">
		<div class="concept-section-heading">
			<p class="concept-section-index">04 · 想一想</p>
			<h2 id="concept-practice-title">用一个问题检查理解</h2>
		</div>
		<div class="concept-practice-body">
			<p>{profile.practice.question}</p>
			<details>
				<summary>查看答案</summary>
				<p>{profile.practice.answer}</p>
			</details>
		</div>
	</section>

	<section class="concept-boundary" aria-labelledby="concept-boundary-title">
		<span>老师提醒</span>
		<div>
			<h2 id="concept-boundary-title">最容易踩的坑</h2>
			<p>{profile.warning}</p>
		</div>
	</section>

	<nav class="concept-detail-pagination" aria-label="相邻术语">
		{
			previousConcept ? (
				<a href={`/vibe-coding/terms/${previousConcept.id}/`} rel="prev">
					<span>上一个</span>
					<strong>{previousConcept.chineseName}</strong>
				</a>
			) : null
		}
		{
			nextConcept ? (
				<a href={`/vibe-coding/terms/${nextConcept.id}/`} rel="next">
					<span>下一个</span>
					<strong>{nextConcept.chineseName}</strong>
				</a>
			) : null
		}
	</nav>
</article>
